# 复制成 backend/.env 后填写。.env 已被 .gitignore 排除，不要提交。
# 所有付费开关默认关闭；只有在明确授权一次真实调用后才临时启用。

# ── 文本模型（DeepSeek）──
MODEL_API_KEY=
MODEL_NAME=deepseek-flash
MODEL_BASE_URL=https://api.deepseek.com
KNOWLEDGE_ALLOW_PAID=0
KNOWLEDGE_PRICING_CONFIRMED=0

# ── 生图（阿里云百炼 · 北京地域 · 万相）──
DASHSCOPE_API_KEY=
KNOWLEDGE_IMAGE_MODEL=wanx2.0-t2i-turbo
KNOWLEDGE_IMAGE_BASE_URL=https://dashscope.aliyuncs.com
KNOWLEDGE_ALLOW_IMAGES=0
KNOWLEDGE_IMAGE_PRICING_CONFIRMED=0

# ── 配音（阿里云百炼 · qwen3-tts）──
KNOWLEDGE_TTS_MODEL=qwen3-tts-flash
KNOWLEDGE_TTS_VOICE=Cherry
KNOWLEDGE_TTS_BASE_URL=https://dashscope.aliyuncs.com
KNOWLEDGE_ALLOW_TTS=0
KNOWLEDGE_TTS_PRICING_CONFIRMED=0
